# Local development defaults. Never place real secrets in this file.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LANGUAGE_CODE=pt-br
DJANGO_TIME_ZONE=Europe/Rome
DJANGO_LOG_LEVEL=INFO
DJANGO_BACKUP_ROOT=backups
DJANGO_PG_DUMP_BINARY=pg_dump
DJANGO_PG_RESTORE_BINARY=pg_restore
LEGAL_DOCUMENTS_VERSION=2026-08-25
LEGAL_EFFECTIVE_DATE=2026-08-25
LEGAL_CONTROLLER_NAME=Escola de Tênis de Mesa
LEGAL_CONTACT_EMAIL=contato@escoladetenisdemesa.com.br

# Stripe test billing (disabled until the full flow has been validated)
STRIPE_BILLING_ENABLED=False
STRIPE_LIVE_MODE=False
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_1UBDAWEsVM71g2d35YM4rjLD
STRIPE_PRICE_PROFESSIONAL_YEARLY=price_1UBDEJEsVM71g2d3q5g6AHUp
SUBSCRIPTION_TRIAL_ENABLED=False
SUBSCRIPTION_TRIAL_DAYS=7
SUBSCRIPTION_ACCESS_ENFORCED=False
LEGAL_COUNTRY=Brazil

# Production-only examples
# DATABASE_URL=postgresql://user:password@host:5432/database
# DJANGO_ALLOWED_HOSTS=app.tabletennismanager.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.tabletennismanager.com
# Recommended on Render (HTTPS API; SMTP ports are unavailable on free services)
# DJANGO_EMAIL_BACKEND=anymail.backends.resend.EmailBackend
# RESEND_API_KEY=
# DJANGO_DEFAULT_FROM_EMAIL=Table Tennis Manager <noreply@escoladetenisdemesa.com.br>
# Alternative SMTP configuration for hosts that permit SMTP connections:
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_EMAIL_TIMEOUT=10
# DJANGO_PASSWORD_RESET_TIMEOUT=3600
# Configure and verify SPF, DKIM and DMARC before sending to real users.
# DJANGO_SECURE_HSTS_SECONDS=3600
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_SECURE_HSTS_PRELOAD=False
