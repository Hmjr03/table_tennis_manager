# Local development defaults. Never place real secrets in this file.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LANGUAGE_CODE=pt-br
DJANGO_TIME_ZONE=Europe/Rome
DJANGO_LOG_LEVEL=INFO
DJANGO_BACKUP_ROOT=backups
DJANGO_PG_DUMP_BINARY=pg_dump
DJANGO_PG_RESTORE_BINARY=pg_restore
LEGAL_DOCUMENTS_VERSION=2026-08-25
LEGAL_EFFECTIVE_DATE=2026-08-25
LEGAL_CONTROLLER_NAME=Escola de Tênis de Mesa
LEGAL_CONTACT_EMAIL=contato@escoladetenisdemesa.com.br
LEGAL_COUNTRY=Brazil

